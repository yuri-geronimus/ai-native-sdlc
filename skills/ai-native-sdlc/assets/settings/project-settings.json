{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"__SKILL_DIR__/scripts/hooks.py\" user-prompt", "timeout": 10}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|Monitor|PowerShell|mcp__.*",
        "hooks": [
          {"type": "command", "command": "python3 \"__SKILL_DIR__/scripts/hooks.py\" pre-tool", "timeout": 30}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|AskUserQuestion|ExitPlanMode",
        "hooks": [
          {"type": "command", "command": "python3 \"__SKILL_DIR__/scripts/hooks.py\" post-tool", "timeout": 120}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"__SKILL_DIR__/scripts/hooks.py\" stop", "timeout": 30}
        ]
      }
    ]
  }
}
