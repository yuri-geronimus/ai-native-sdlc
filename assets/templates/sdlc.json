    "bash_patterns": ["\\bdeploy\\b.*\\bprod(uction)?\\b", "\\bprod(uction)?\\b.*\\bdeploy\\b", "kubectl\\s+.*(apply|delete|rollout|scale|set|patch|replace|edit)\\b.*(-n|--namespace)[ =]?prod", "kubectl\\s+[^|;&]*(-n|--namespace)[ =]?prod[^|;&]*\\b(apply|delete|rollout|scale|set|patch|replace|edit)\\b", "kubectl\\b[^|;&]*--(context|cluster)[ =]\\S*prod[^|;&]*\\b(apply|delete|rollout|scale|set|patch|replace|edit)\\b", "kubectl\\b[^|;&]*\\b(apply|delete|rollout|scale|set|patch|replace|edit)\\b[^|;&]*--(context|cluster)[ =]\\S*prod", "\\bhelm\\s+(upgrade|install|rollback|uninstall)\\b.*\\bprod", "\\bhelm\\b[^|;&]*--kube-context[ =]\\S*prod[^|;&]*\\b(upgrade|install|rollback|uninstall)\\b", "\\bterraform\\b(\\s+-\\S+)*\\s+(apply|destroy)\\b", "\\bgh\\s+workflow\\s+run\\b.*\\b(deploy|release)\\b.*\\bprod", "\\bgit\\s+push\\s+(-\\S+\\s+)*prod(uction)?\\b"],
    "mcp_tools": ["mcp__.*__deploy_prod.*", "mcp__.*__.*production.*"],
    "approval_check": "",
    "approval_timeout_s": 20
  },
  "runbooks": {},
  "evals_dir": "evals"
